# ══════════════════════════════════════════════════════════
#  ALMA DE MAR · Ajustes del servidor
# ──────────────────────────────────────────────────────────
#  COPIA ESTE ARCHIVO COMO  .env  (sin «.ejemplo») y rellénalo.
#
#      cp .env.ejemplo .env
#
#  El `.env` no se sube a git, así que cada servidor tiene el
#  suyo y `git pull` nunca te lo pisa. Este `.env.ejemplo` sí
#  se sube: es la plantilla, y NO debe llevar llaves reales.
#
#  Todo lo de aquí es opcional. Lo que no pongas usa el valor
#  por defecto que trae el código.
# ══════════════════════════════════════════════════════════


# ── Cobro con Stripe ──────────────────────────────────────
# Las dos llaves salen del panel de Stripe. Mientras no estén,
# la tienda se ve y el carrito funciona, pero el botón de pagar
# avisa de que falta configurarlo — no se rompe nada.

# Desarrolladores → Claves de API → «Clave secreta».
# Empieza por sk_test_ mientras pruebas y sk_live_ cuando ya
# cobres de verdad. OJO: es la SECRETA, no la publicable.
STRIPE_SECRETO=

# Desarrolladores → Webhooks → añade el endpoint
#     https://TU-DOMINIO/api/webhook-stripe.php
# con el evento   checkout.session.completed
# y copia aquí su «Clave de firma» (whsec_…).
#
# Esto es lo que marca un pedido como pagado. Sin ello los cobros
# entran en Stripe pero los pedidos se quedan en «sin pagar»:
# volver a la página de gracias no prueba nada, porque esa
# dirección la puede abrir cualquiera.
STRIPE_WEBHOOK=

# Solo si Stripe devuelve a la clienta a una dirección equivocada
# (por ejemplo, detrás de un proxy). Normalmente se deduce sola.
# SITIO_URL=https://almademar.mx


# ── Envíos ────────────────────────────────────────────────
# Escalones de peso facturable, en pesos. Se cobra el primero
# cuyo límite alcance el peso del paquete.
#
# ¡OJO! Los valores por defecto son ESTIMACIONES, sacadas de
# precios públicos de guía prepagada terrestre. NO son tu tarifa.
# Pon aquí tu cotización real de paquetería antes de vender: de
# estos números sale el cobro de todos tus envíos.
# ENVIO_TARIFA_1KG=145
# ENVIO_TARIFA_3KG=155
# ENVIO_TARIFA_5KG=160
# ENVIO_TARIFA_10KG=172
# ENVIO_TARIFA_15KG=180
# ENVIO_TARIFA_25KG=202
# ENVIO_TARIFA_35KG=220

# Arriba del último escalón: cargo por cada kilo adicional.
# ENVIO_POR_KG_EXTRA=12

# Peso volumétrico: (largo × ancho × alto en cm) / divisor.
# La paquetería terrestre en México usa 5000.
# ENVIO_DIVISOR_VOLUMETRICO=5000

# Los frascos no se acomodan perfecto en la caja: hay paredes,
# burbuja y huecos. El volumen sumado se infla por este factor.
# ENVIO_FACTOR_EMPAQUE=1.35

# Peso de la caja, burbuja y relleno, en gramos.
# ENVIO_TARA_GRAMOS=150

# Destinos que la paquetería cobra aparte. Se comparan por los
# DOS PRIMEROS dígitos del código postal, así que 97 cubre todo
# Yucatán. Pon el sobrecargo en 0 si tu tarifa es plana.
# ENVIO_SOBRECARGO_ZONA=131.40
# ENVIO_PREFIJOS_ZONA=97,98,77,24,29,30,23,22,21,88,87

# Porcentaje que la paquetería suma cada mes sobre la tarifa.
# Déjalo en 0 si tu tarifa ya lo trae incluido.
# ENVIO_COMBUSTIBLE_PCT=0

# Días hábiles estimados de entrega. Se le enseñan a la clienta.
# ENVIO_DIAS_MIN=3
# ENVIO_DIAS_MAX=7


# ── Recoger en el spa ─────────────────────────────────────
# Opción sin costo en el checkout. Ponlo en false para ofrecer
# solo envíos.
# RECOGER_ACTIVO=true
# RECOGER_DIRECCION=Av. Fiestas de Mayo #18, Condominios Torres del Mar, Dep. 10F
